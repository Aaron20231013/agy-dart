{
  "agy-dart-lifecycle": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-start.mjs",
        "timeout": 8
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
